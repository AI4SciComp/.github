{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AI4SciComp/.github/blob/main/docs/repository-map.schema.json",
  "title": "AI4SciComp repository map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repositories"],
  "properties": {
    "schema_version": {"const": "ai4scicomp.repository-map/v1"},
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/repository"}
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "status",
        "maturity",
        "visibility",
        "plane",
        "role",
        "languages",
        "public_dependencies",
        "build_dependencies",
        "research_sidecar",
        "must_not_depend_on"
      ],
      "properties": {
        "name": {"type": "string", "pattern": "^(\\.github|asc-[a-z0-9-]+)$"},
        "status": {"enum": ["active", "planned", "archived"]},
        "maturity": {"enum": ["governance", "foundation", "implemented", "incubating", "skeleton", "planned"]},
        "visibility": {"enum": ["public", "private", "not-created"]},
        "plane": {"enum": ["research", "scientific-computing", "engineering"]},
        "role": {"type": "string", "minLength": 1},
        "languages": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "public_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "build_dependencies": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "research_sidecar": {"type": ["string", "null"]},
        "must_not_depend_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    }
  }
}
